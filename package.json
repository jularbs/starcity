{
  "name": "starcityapi",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsup src/server.ts --format esm --clean --watch --onSuccess \"mkdir -p dist/templates && cp -R src/modules/email/templates/. dist/templates/ && node --watch dist/server.js\"",
    "build": "tsup src/server.ts --format esm --clean && mkdir -p dist/templates && cp -R src/modules/email/templates/. dist/templates/",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:watch": "vitest --config vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "docker:up": "docker compose -f docker/compose.yaml up -d",
    "docker:down": "docker compose -f docker/compose.yaml down",
    "docker:down:volumes": "docker compose -f docker/compose.yaml down -v",
    "docker:logs": "docker compose -f docker/compose.yaml logs -f",
    "docker:ps": "docker compose -f docker/compose.yaml ps"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "convert-array-to-csv": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^1.3.8",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "juice": "^12.1.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "nanoid": "^6.0.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "string-strip-html": "^13.7.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.1",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
