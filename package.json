{
  "name": "starcityapi",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsup src/server.js --format esm --clean --watch --onSuccess \"node --watch dist/server.js\"",
    "build": "tsup src/server.js --format esm --clean",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:watch": "vitest --config vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "docker:up": "docker compose -f docker/compose.yaml up -d",
    "docker:down": "docker compose -f docker/compose.yaml down",
    "docker:down:volumes": "docker compose -f docker/compose.yaml down -v",
    "docker:logs": "docker compose -f docker/compose.yaml logs -f",
    "docker:ps": "docker compose -f docker/compose.yaml ps"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1018.0",
    "axios": "^1.18.1",
    "convert-array-to-csv": "^2.0.0",
    "cors": "^2.8.5",
    "date-fns": "^2.22.1",
    "date-fns-tz": "^1.1.6",
    "dotenv": "^10.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "formidable": "^1.2.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "morgan": "^1.10.0",
    "mysql": "^2.18.1",
    "nanoid": "^5.1.16",
    "node-cron": "^3.0.0",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.4.4",
    "sharp": "^0.35.4",
    "shortid": "^2.2.16",
    "slugify": "^1.5.3",
    "string-strip-html": "^8.3.0",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
