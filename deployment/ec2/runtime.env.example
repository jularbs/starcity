NODE_ENV=production
APP_NAME="Star City UAT"
PORT=8000

CORS_DOMAINS='["https://uat.starcity.com.ph","https://uat-manage.starcity.com.ph"]'
DOMAIN=https://uat-api.starcity.com.ph
WEBSITE_URL=https://uat.starcity.com.ph
MANAGE_URL=https://uat-manage.starcity.com.ph
JWT_COOKIE_SECURE=true

MONGO_ROOT_USER=starcity_uat
MONGO_ROOT_PASSWORD=replace-with-hex-password
DB_CONNECTION_STRING=mongodb://starcity_uat:replace-with-hex-password@127.0.0.1:27017/starcity_uat?authSource=admin

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=starcity_uat
MYSQL_PASSWORD=replace-with-hex-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-hex-password
MYSQL_DB=starcity_uat

JWT_SECRET=replace-with-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
JWT_ACCESS_EXPIRES_IN_MINUTES=15
JWT_REFRESH_EXPIRES_IN_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=60
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

AWS_S3_PUBLICKEY=replace-with-UAT-only-access-key
AWS_S3_SECRETKEY=replace-with-UAT-only-secret-key
AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKETNAME=replace-with-UAT-only-bucket

# Configure your remote SMTP provider's authenticated host and TLS settings.
EMAIL_PROTOCOL=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_ENCRYPTION=tls
EMAIL_ADDRESS=uat-sender@example.com
EMAIL_PASSWORD=replace-with-UAT-only-smtp-password
EMAIL_SECURE=false

DATA_RETENTION_DAYS=500
SM_TOKEN=replace-with-nonproduction-token
REPORTS_RECIPIENT=uat-testers@example.com
PAYMAYA_PUBLIC_KEY=replace-with-sandbox-public-key
PAYMAYA_ENVIRONMENT=sandbox
PAYMAYA_ALLOWED_IPS=replace-with-current-sandbox-webhook-ips
TURNSTILE_SYNC_ENABLED=false

# These public values are read during the manual Next.js build.
NEXT_PUBLIC_API_ENDPOINT=https://uat-api.starcity.com.ph/api
NEXT_PUBLIC_WEB_DOMAIN=https://uat.starcity.com.ph
NEXT_PUBLIC_MANAGE_DOMAIN=https://uat-manage.starcity.com.ph
NEXT_PUBLIC_ENV=production
# NEXT_PUBLIC_BPI_CHECKOUT_URL=
# NEXT_PUBLIC_BPI_CLIENT_ID=