<!DOCTYPE html
  PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en" xml:lang="en">

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title></title>

  <style>
    /* =========================================================
         Email base
         ========================================================= */

    html,
    body {
      min-width: 100%;
      width: 100%;
      margin: 0;
      padding: 0;
      background: #f90 !important;
      color: #0a0a0a;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.3;
      text-align: left;
      -moz-box-sizing: border-box;
      -ms-text-size-adjust: 100%;
      -webkit-box-sizing: border-box;
      -webkit-text-size-adjust: 100%;
      box-sizing: border-box;
    }

    table {
      border-collapse: collapse;
      border-spacing: 0;
    }

    table,
    tr,
    td,
    th {
      margin: 0;
      padding: 0;
      vertical-align: top;
    }

    td,
    th {
      color: #0a0a0a;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.3;
      text-align: left;
      word-wrap: break-word;
      -moz-hyphens: auto;
      -webkit-hyphens: auto;
      hyphens: auto;
    }

    a {
      color: inherit;
    }

    /* =========================================================
         Layout
         ========================================================= */

    .email-body {
      width: 100%;
      min-width: 100%;
      height: 100%;
      background: #f90 !important;
      text-align: left;
    }

    .email-center {
      width: 100%;
      min-width: 580px;
    }

    .email-container {
      width: 580px;
      margin: 0 auto;
      background: #fefefe;
      text-align: center;
      float: none;
    }

    .email-content {
      width: 100%;
      padding: 0 16px;
      box-sizing: border-box;
    }

    .row {
      display: table;
      position: relative;
      width: 100%;
      text-align: left;
    }

    .column {
      width: 100%;
      padding: 0 16px 16px;
      box-sizing: border-box;
    }

    .column-half {
      width: 50%;
      padding-bottom: 16px;
    }

    .column-half-first {
      padding-left: 0 !important;
      padding-right: 8px;
    }

    .column-half-last {
      padding-left: 8px;
      padding-right: 0 !important;
    }

    .inner-table {
      width: 100%;
    }

    /* =========================================================
         Typography
         ========================================================= */

    .heading {
      margin: 0 0 10px;
      color: inherit;
      font-family: Helvetica, Arial, sans-serif;
      line-height: 1.3;
      text-align: left;
    }

    .heading-xl {
      font-size: 34px;
      font-weight: 900;
    }

    .heading-section {
      margin: 0 0 10px;
      font-size: 24px;
      font-weight: 700;
      text-align: center;
    }

    .text {
      margin: 0 0 10px;
      color: #0a0a0a;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.3;
      text-align: left;
    }

    .text-light {
      font-weight: 300;
    }

    .text-bold {
      font-weight: 700;
    }

    .text-warning {
      color: #cc0000;
      font-weight: 700;
    }

    .text-small {
      font-size: 12px !important;
    }

    .text-center {
      text-align: center;
    }

    /* =========================================================
         Spacing
         ========================================================= */

    .spacer {
      width: 100%;
    }

    .spacer td {
      font-size: 0;
      line-height: 0;
      mso-line-height-rule: exactly;
    }

    .spacer-30 td {
      height: 30px;
    }

    .spacer-20 td {
      height: 20px;
    }

    .spacer-15 td {
      height: 15px;
    }

    /* =========================================================
         Button
         ========================================================= */

    .button-wrapper {
      width: auto;
      margin: 0 0 16px;
      text-align: center;
    }

    .button {
      display: inline-block;
      padding: 10px 20px;
      border: 0 solid #ffae00;
      border-radius: 3px;
      background: #ffae00;
      color: #fefefe;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 20px;
      font-weight: 700;
      line-height: 1.3;
      text-align: center;
      text-decoration: none;
    }

    /* =========================================================
         Purchase details
         ========================================================= */

    .purchase-table {
      width: 100%;
    }

    .purchase-table th,
    .purchase-table td {
      padding: 5px !important;
    }

    .purchase-table th {
      font-weight: 600;
    }

    .purchase-total td:first-child {
      font-weight: 700;
    }

    .purchase-divider {
      margin: 0;
    }

    /* =========================================================
         Footer
         ========================================================= */

    .footer {
      text-align: center;
    }

    .footer-column {
      width: 50%;
      padding-bottom: 16px;
    }

    .footer-column-first {
      padding-left: 16px;
      padding-right: 8px;
    }

    .footer-column-last {
      padding-left: 8px;
      padding-right: 16px;
    }

    /* =========================================================
         Utility / email-client helpers
         ========================================================= */

    .preheader {
      display: none !important;
      width: 0;
      max-width: 0;
      max-height: 0;
      overflow: hidden;
      color: #f3f3f3;
      font-size: 1px;
      line-height: 1px;
      opacity: 0;
      visibility: hidden;
      mso-hide: all !important;
    }

    .gmail-font-fix {
      display: none;
      white-space: nowrap;
      font: 15px courier;
      line-height: 0;
    }

    @media only screen {
      html {
        min-height: 100%;
        background: #f3f3f3;
      }
    }

    @media only screen and (max-width: 596px) {
      .email-center {
        min-width: 0 !important;
      }

      .email-container {
        width: 95% !important;
      }

      .email-content {
        width: 100%;
        padding-left: 16px !important;
        padding-right: 16px !important;
      }

      .column,
      .column-half,
      .footer-column {
        height: auto !important;
        box-sizing: border-box;
      }

      .column-half,
      .footer-column {
        display: inline-block !important;
        width: 50% !important;
      }

      .column-full {
        display: block !important;
        width: 100% !important;
      }

      .column-half-first {
        padding-left: 0 !important;
      }

      .column-half-last {
        padding-right: 0 !important;
      }

      .button-wrapper {
        width: 100% !important;
      }
    }
  </style>
</head>

<body>
  <span class="preheader"></span>

  <table class="email-body">
    <tr>
      <td class="email-content" align="center" valign="top">
        <center class="email-center">
          <table class="email-container" align="center">
            <tbody>
              <tr>
                <td class="email-content">

                  <!-- Top spacing -->
                  <table class="spacer spacer-30">
                    <tbody>
                      <tr>
                        <td height="30">&nbsp;</td>
                      </tr>
                    </tbody>
                  </table>

                  <!-- Introduction -->
                  <table class="row">
                    <tbody>
                      <tr>
                        <th class="column column-full">
                          <table class="inner-table">
                            <tbody>
                              <tr>
                                <th>
                                  <h1 class="heading heading-xl">
                                    Greetings, {{customerName}}
                                  </h1>

                                  <p class="text text-light">
                                    Thank you for purchasing Star City tickets! We hope that you have an awesome
                                    experience and enjoy our rides and attractions.
                                  </p>

                                  <p class="text text-light">
                                    These QR Codes are your tickets to the park and are
                                    <strong>valid until {{expiryDate}}.</strong>
                                    Please download the QR codes and print or save in your mobile phone for scanning
                                    at the park's main entrance turnstiles. One QR code per person.
                                  </p>

                                  <p class="text text-light">
                                    Please also print or screenshot this Acknowledgement Receipt as Star City reserves
                                    the right to demand presentation of the same before entry to the park.
                                  </p>

                                  <p class="text text-warning">
                                    Please visit our website
                                    <a href="http://www.starcity.com.ph" target="_blank">
                                      http://www.starcity.com.ph
                                    </a>
                                    and social media pages (Facebook and Instagram) for park operation schedule or
                                    updates on the day of your intended visit.
                                  </p>

                                  <p class="text">
                                    Your Reference ID number is {{refId}}
                                  </p>
                                </th>
                              </tr>
                            </tbody>
                          </table>

                          <!-- QR button spacing -->
                          <table class="spacer spacer-20">
                            <tbody>
                              <tr>
                                <td height="20">&nbsp;</td>
                              </tr>
                            </tbody>
                          </table>

                          <!-- QR button -->
                          <center>
                            <table class="button-wrapper">
                              <tbody>
                                <tr>
                                  <td>
                                    <a class="button"
                                      href="{{websiteUrl}}/accesspass?s={{salt}}&r={{refId}}"
                                      target="_blank">
                                      CLICK HERE TO VIEW QR CODES
                                    </a>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </center>

                          <!-- Details spacing -->
                          <table class="spacer spacer-15">
                            <tbody>
                              <tr>
                                <td height="15">&nbsp;</td>
                              </tr>
                            </tbody>
                          </table>

                          <!-- Customer / payment details -->
                          <table class="row">
                            <tbody>
                              <tr>
                                <th class="column column-half column-half-first">
                                  <table class="inner-table">
                                    <tbody>
                                      <tr>
                                        <th>
                                          <p class="text">
                                            <span class="text-bold">Customer Name</span><br />
                                            <span class="text-light">{{customerName}}</span>
                                          </p>

                                          <p class="text">
                                            <span class="text-bold">Email Address</span><br />
                                            <span class="text-light">{{emailAddress}}</span>
                                          </p>

                                          <p class="text">
                                            <span class="text-bold">Mobile Number</span><br />
                                            <span class="text-light">{{contactNumber}}</span>
                                          </p>
                                        </th>
                                      </tr>
                                    </tbody>
                                  </table>
                                </th>

                                <th class="column column-half column-half-last">
                                  <table class="inner-table">
                                    <tbody>
                                      <tr>
                                        <th>
                                          <p class="text">
                                            <span class="text-bold">Payment Gateway</span><br />
                                            <span class="text-light">{{paymentDetails.option.name}}</span>
                                          </p>

                                          <p class="text">
                                            <span class="text-bold">Transaction Number</span><br />
                                            <span class="text-light">{{paymentDetails.referenceNumber}}</span>
                                          </p>

                                          <p class="text">
                                            <span class="text-bold">Amount Paid</span><br />
                                            <span class="text-light">{{orderTotal}}</span>
                                          </p>
                                        </th>
                                      </tr>
                                    </tbody>
                                  </table>
                                </th>
                              </tr>
                            </tbody>
                          </table>

                          <!-- Purchase details spacing -->
                          <table class="spacer spacer-30">
                            <tbody>
                              <tr>
                                <td height="30">&nbsp;</td>
                              </tr>
                            </tbody>
                          </table>

                          <!-- Purchase details -->
                          <h4 class="heading heading-section">
                            Purchase Details
                          </h4>

                          <table class="purchase-table">
                            <tr>
                              <th>Ticket Type</th>
                              <th>Qty</th>
                              <th>Price</th>
                            </tr>

                            {{#each cartItems}}
                            <tr>
                              <td>{{ticketId.name}}</td>
                              <td>{{qty}}</td>
                              <td>Php {{priceAcquired}}</td>
                            </tr>
                            {{/each}}

                            <tr class="purchase-total">
                              <td colspan="2">Subtotal:</td>
                              <td>Php {{orderTotal}}</td>
                            </tr>
                          </table>

                          <hr class="purchase-divider" />
                        </th>
                      </tr>
                    </tbody>
                  </table>

                  <!-- Footer -->
                  <table class="row footer">
                    <tbody>
                      <tr>
                        <th class="footer-column footer-column-first">
                          <table class="inner-table">
                            <tbody>
                              <tr>
                                <th>
                                  <p class="text text-small">
                                    <strong>Star Parks Corporation</strong><br />
                                    Call us at 8-473-28-45<br />
                                    Email us at helpdesk@starcity.com.ph
                                  </p>
                                </th>
                              </tr>
                            </tbody>
                          </table>
                        </th>

                        <th class="footer-column footer-column-last">
                          <table class="inner-table">
                            <tbody>
                              <tr>
                                <th>
                                  <p class="text text-small">
                                    MBC Building, V.Sotto Street,<br />
                                    CCP Complex, Roxas Boulevard<br />
                                    Pasay City, Metro Manila
                                  </p>
                                </th>
                              </tr>
                            </tbody>
                          </table>
                        </th>
                      </tr>
                    </tbody>
                  </table>

                </td>
              </tr>
            </tbody>
          </table>
        </center>
      </td>
    </tr>
  </table>

  <!-- Prevent Gmail on iOS font size manipulation -->
  <div class="gmail-font-fix">
    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
  </div>
</body>

</html>