{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsup src/server.ts --format esm --clean --watch --onSuccess \"mkdir -p dist/templates && cp -R src/modules/email/templates/. dist/templates/ && node --watch dist/server.js\"",
    "build": "tsup src/server.ts --format esm --clean && mkdir -p dist/templates && cp -R src/modules/email/templates/. dist/templates/",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:watch": "vitest --config vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose -f docker/compose.yaml up -d",
    "docker:down": "docker compose -f docker/compose.yaml down",
    "docker:down:volumes": "docker compose -f docker/compose.yaml down -v",
    "docker:logs": "docker compose -f docker/compose.yaml logs -f",
    "docker:ps": "docker compose -f docker/compose.yaml ps"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/matcher-pwned": "^4.1.3",
    "convert-array-to-csv": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.5",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "juice": "^12.2.0",
    "mongoose": "^9.10.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nanoid": "^6.0.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.14",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "string-strip-html": "^13.7.7",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
