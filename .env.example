NODE_ENV=development

APP_NAME=API NAME
PORT=8000

CORS_DOMAINS=["http://localhost:3000","http://localhost:3001"]

DB_CONNECTION_STRING=mongodb://username:password@host:port/dbname

MYSQL_HOST=db.host.of.turnstile.com
MYSQL_USER=username
MYSQL_PASSWORD=password
MYSQL_DB=dbname
MYSQL_PORT=3306

JWT_SECRET=jwt-sha512-key

DOMAIN=https://api.example.com
WEBSITE_URL=https://frontend.example.com

AWS_S3_PUBLICKEY=aws-public-key
AWS_S3_SECRETKEY=aws-secret-key
AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKETNAME=bucket-name

EMAIL_PROTOCOL=smtp
EMAIL_HOST=smtp.host.com
EMAIL_ENCRYPTION=tls
EMAIL_ADDRESS=your-email@example.com
EMAIL_PORT=587
EMAIL_PASSWORD=your-email-password
EMAIL_SECURE=false

DATA_RETENTION_DAYS=500

SM_TOKEN=sm-tickets-api-key

REPORTS_RECIPIENT=your-email@example.com

PAYMAYA_PUBLIC_KEY=pk-paymaya-public-key
PAYMAYA_ENVIRONMENT=sandbox
PAYMAYA_ALLOWED_IPS=13.229.160.234,3.1.199.75

