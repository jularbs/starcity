<!DOCTYPE html
  PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en" xml:lang="en">

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title></title>

  <style>
    html,
    body {
      min-width: 100%;
      width: 100%;
      margin: 0;
      padding: 0;
      background: #f90 !important;
      color: #0a0a0a;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.3;
      text-align: left;
      -moz-box-sizing: border-box;
      -ms-text-size-adjust: 100%;
      -webkit-box-sizing: border-box;
      -webkit-text-size-adjust: 100%;
      box-sizing: border-box;
    }

    table {
      border-collapse: collapse;
      border-spacing: 0;
    }

    table,
    tr,
    td,
    th {
      margin: 0;
      padding: 0;
      vertical-align: top;
    }

    td,
    th {
      color: #0a0a0a;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.3;
      text-align: left;
      word-wrap: break-word;
      -moz-hyphens: auto;
      -webkit-hyphens: auto;
      hyphens: auto;
    }

    a {
      color: inherit;
    }

    .email-body {
      width: 100%;
      min-width: 100%;
      height: 100%;
      background: #f90 !important;
      text-align: left;
    }

    .email-center {
      width: 100%;
      min-width: 580px;
    }

    .email-container {
      width: 580px;
      margin: 0 auto;
      background: #fefefe;
      text-align: center;
      float: none;
    }

    .email-content {
      width: 100%;
      padding: 0 16px;
      box-sizing: border-box;
    }

    .row {
      display: table;
      position: relative;
      width: 100%;
      text-align: left;
    }

    .column {
      width: 100%;
      padding: 0 16px 16px;
      box-sizing: border-box;
    }

    .inner-table {
      width: 100%;
    }

    .heading {
      margin: 0 0 10px;
      color: inherit;
      font-family: Helvetica, Arial, sans-serif;
      line-height: 1.3;
      text-align: left;
    }

    .heading-xl {
      font-size: 34px;
      font-weight: 900;
    }

    .text {
      margin: 0 0 10px;
      color: #0a0a0a;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.3;
      text-align: left;
    }

    .text-light {
      font-weight: 300;
    }

    .text-warning {
      color: #cc0000;
      font-weight: 700;
    }

    .text-small {
      font-size: 12px !important;
    }

    .spacer {
      width: 100%;
    }

    .spacer td {
      font-size: 0;
      line-height: 0;
      mso-line-height-rule: exactly;
    }

    .spacer-30 td {
      height: 30px;
    }

    .spacer-20 td {
      height: 20px;
    }

    .button-wrapper {
      width: auto;
      margin: 0 0 16px;
      text-align: center;
    }

    .button {
      display: inline-block;
      padding: 10px 20px;
      border: 0 solid #ffae00;
      border-radius: 3px;
      background: #ffae00;
      color: #fefefe;
      font-family: Helvetica, Arial, sans-serif;
      font-size: 20px;
      font-weight: 700;
      line-height: 1.3;
      text-align: center;
      text-decoration: none;
    }

    .footer {
      text-align: center;
    }

    .footer-column {
      width: 50%;
      padding-bottom: 16px;
    }

    .footer-column-first {
      padding-left: 16px;
      padding-right: 8px;
    }

    .footer-column-last {
      padding-left: 8px;
      padding-right: 16px;
    }

    .preheader {
      display: none !important;
      width: 0;
      max-width: 0;
      max-height: 0;
      overflow: hidden;
      color: #f3f3f3;
      font-size: 1px;
      line-height: 1px;
      opacity: 0;
      visibility: hidden;
      mso-hide: all !important;
    }

    @media only screen {
      html {
        min-height: 100%;
        background: #f3f3f3;
      }
    }

    @media only screen and (max-width: 596px) {
      .email-center {
        min-width: 0 !important;
      }

      .email-container {
        width: 95% !important;
      }

      .email-content {
        width: 100%;
        padding-left: 16px !important;
        padding-right: 16px !important;
      }

      .column,
      .footer-column {
        height: auto !important;
        box-sizing: border-box;
      }

      .footer-column {
        display: inline-block !important;
        width: 50% !important;
      }

      .button-wrapper {
        width: 100% !important;
      }
    }
  </style>
</head>

<body>
  <span class="preheader"></span>

  <table class="email-body">
    <tr>
      <td class="email-content" align="center" valign="top">
        <center class="email-center">
          <table class="email-container" align="center">
            <tbody>
              <tr>
                <td class="email-content">

                  <table class="spacer spacer-30">
                    <tbody>
                      <tr>
                        <td height="30">&nbsp;</td>
                      </tr>
                    </tbody>
                  </table>

                  <table class="row">
                    <tbody>
                      <tr>
                        <th class="column column-full">
                          <table class="inner-table">
                            <tbody>
                              <tr>
                                <th>
                                  <h1 class="heading heading-xl">
                                    Password reset request
                                  </h1>

                                  <p class="text text-light">
                                    Hi {{name}}, we received a request to reset the password for your Star City
                                    Manage account. Click the button below to choose a new password.
                                  </p>

                                  <p class="text text-warning">
                                    This link will expire in {{expiresInMinutes}} minutes. If you didn't request a
                                    password reset, you can safely ignore this email &mdash; your password will not
                                    be changed.
                                  </p>
                                </th>
                              </tr>
                            </tbody>
                          </table>

                          <table class="spacer spacer-20">
                            <tbody>
                              <tr>
                                <td height="20">&nbsp;</td>
                              </tr>
                            </tbody>
                          </table>

                          <center>
                            <table class="button-wrapper">
                              <tbody>
                                <tr>
                                  <td>
                                    <a class="button" href="{{resetUrl}}" target="_blank">
                                      RESET YOUR PASSWORD
                                    </a>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </center>

                          <p class="text text-small text-light">
                            If the button above doesn't work, copy and paste this link into your browser:<br />
                            <a href="{{resetUrl}}" target="_blank">{{resetUrl}}</a>
                          </p>
                        </th>
                      </tr>
                    </tbody>
                  </table>

                  <table class="spacer spacer-30">
                    <tbody>
                      <tr>
                        <td height="30">&nbsp;</td>
                      </tr>
                    </tbody>
                  </table>

                  <table class="row footer">
                    <tbody>
                      <tr>
                        <th class="footer-column footer-column-first">
                          <table class="inner-table">
                            <tbody>
                              <tr>
                                <th>
                                  <p class="text text-small">
                                    <strong>Star Parks Corporation</strong><br />
                                    Call us at 8-473-28-45<br />
                                    Email us at helpdesk@starcity.com.ph
                                  </p>
                                </th>
                              </tr>
                            </tbody>
                          </table>
                        </th>

                        <th class="footer-column footer-column-last">
                          <table class="inner-table">
                            <tbody>
                              <tr>
                                <th>
                                  <p class="text text-small">
                                    MBC Building, V.Sotto Street,<br />
                                    CCP Complex, Roxas Boulevard<br />
                                    Pasay City, Metro Manila
                                  </p>
                                </th>
                              </tr>
                            </tbody>
                          </table>
                        </th>
                      </tr>
                    </tbody>
                  </table>

                </td>
              </tr>
            </tbody>
          </table>
        </center>
      </td>
    </tr>
  </table>
</body>

</html>
